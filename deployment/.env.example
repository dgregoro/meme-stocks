# Copy to .env and fill in secrets. Used by compose (env_file) for container runs.
# For local CLI/uvicorn, config loads repo-root `.env` only unless you export vars yourself.
#
# DATABASE_URL: In the container, default is <WORKDIR>/data/app.db (see compose volume).
# Omit DATABASE_URL in compose to use defaults, or set postgres / another sqlite file explicitly.
# Do not rely on sqlite:///./data/app.db from a host cwd other than repo root—use repo defaults or an absolute path.

# --- Alpaca intraday minute bars (free plan) ---
# Historical bars: use iex (delayed_sip rejected with 400 invalid feed)
# ALPACA_BARS_FEED=iex
# ALPACA_FREE_PLAN_MODE=true
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# --- Start-window grouping (avoids refetch duplication) ---
# INTRADAY_GROUP_SPAN_HOURS=1.0

# --- Scheduling (optional) ---
# PRICE_COLLECTION_INTERVAL_MINUTES=15
# INTRADAY_INGESTION_ENABLED=false
