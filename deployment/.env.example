# Copy to .env and fill in secrets. Used by compose (env_file) for container runs.
# Config does NOT load this path; tests run without credentials.

# --- Alpaca intraday minute bars (free plan) ---
# Historical bars: use iex (delayed_sip rejected with 400 invalid feed)
# ALPACA_BARS_FEED=iex
# ALPACA_FREE_PLAN_MODE=true
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# --- Start-window grouping (avoids refetch duplication) ---
# INTRADAY_GROUP_SPAN_HOURS=1.0

# --- Scheduling (optional) ---
# PRICE_COLLECTION_INTERVAL_MINUTES=15
# INTRADAY_INGESTION_ENABLED=false
