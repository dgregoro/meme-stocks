# For local uvicorn: copy to .env at project root.
# For containers: use deployment/.env (compose env_file). See deployment/.env.example.
# See backend/app/config.py for all options.
# Reddit (required for data collection)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=meme-stocks-app/0.1

# --- Alpaca intraday minute bars (free plan) ---
# Free plan: ALPACA_DATA_FEED=iex (IEX exchange only). Paid Algo Trader Plus: sip (full market).
# Safety buffer (alpaca_end_time_safety_minutes) avoids querying too-recent data on free plan.
# ALPACA_DATA_FEED=iex  # Free plan: iex. Paid Algo Trader Plus: sip
# ALPACA_FREE_PLAN_MODE=true
# ALPACA_SIP_DELAY_MINUTES=15
# ALPACA_END_TIME_SAFETY_MINUTES=20
# ALPACA_MIN_REQUEST_INTERVAL_SECONDS=0.35  # Throttle to stay under 200 req/min. 0 = disabled.

# --- RSI (analysis) — Phase 2.3 ---
# RSI_PERIOD=14
# RSI_OVERBOUGHT=70.0
# RSI_OVERSOLD=30.0
