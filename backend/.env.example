# For local uvicorn: copy to .env at project root.
# For containers: use deployment/.env (compose env_file). See deployment/.env.example.
# See backend/app/config.py for all options.
# Reddit (required for data collection)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=meme-stocks-app/0.1

# --- Alpaca intraday minute bars (free plan) ---
# Full-market SIP on free is 15-min delayed; use delayed_sip. Do not query last ~15 min.
# Real-time on free is IEX-only; we use delayed_sip for broad market. Safety buffer avoids 400/403.
# ALPACA_DATA_FEED=delayed_sip
# ALPACA_FREE_PLAN_MODE=true
# ALPACA_SIP_DELAY_MINUTES=15
# ALPACA_END_TIME_SAFETY_MINUTES=20

# --- RSI (analysis) — Phase 2.3 ---
# RSI_PERIOD=14
# RSI_OVERBOUGHT=70.0
# RSI_OVERSOLD=30.0
